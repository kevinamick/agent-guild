{
  "name": "agent-guild",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "A multiplayer 3D office where Claude Code agents earn XP, level up, and can be borrowed by coworkers.",
  "bin": {
    "agent-guild": "runner/index.js",
    "agent-guild-runner": "runner/index.js",
    "agent-guild-server": "server/index.js"
  },
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "server": "node server/index.js",
    "runner": "node runner/index.js",
    "test": "node --test shared/*.test.js runner/*.test.js server/*.test.js",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  },
  "files": [
    "runner",
    "shared",
    "server",
    "scripts/fake-agent.js",
    "README.md"
  ],
  "overrides": {
    "rolldown": "1.2.9"
  }
}
